{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextobsession",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nextobsession.fans",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextobsession-db",
      "database_id": "3fb99811-2e01-4a3f-a2ff-1af5b4e99793"
    }
  ]
}
