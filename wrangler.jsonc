{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextobsession",
  "vars": {
    "SITE_OPERATOR_NAME": "Andrii Khomenko"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/robots.txt",
      "/llms.txt"
    ]
  },
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nextobsession.fans",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextobsession-db",
      "database_id": "cbe1e8f7-ff9c-4959-b0b4-19557988126e"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "3fb99811-2e01-4a3f-a2ff-1af5b4e99793"
      }
    ]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
